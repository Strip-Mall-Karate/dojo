#!/usr/bin/env bash
# smk { overwrite: true }
#
# Checks the staged files' formatting, then lints them when the repository's checks include lint, as the index
# holds them, and changes nothing. On a formatting difference it stops the commit: run `smk format`, review what
# changed, and stage again. On a lint finding it stops the commit naming the file and the rule. Git (2.54+) runs
# it once `git config hook.smk-format.event pre-commit` and
# `git config hook.smk-format.command .githooks/pre-commit` register it, which `make hooks` does where
# the Makefile has that target. `git commit --no-verify` skips it, and CI runs the same checks on every
# push.
#
# LINT TOO, NOT ONLY FORMAT. A commit whose files were formatted but not linted passed this hook and failed CI on
# one lint rule, a second commit and a second build later. A staged lint takes about a second for TypeScript and
# about 17 s for one C# file, after its 26 s format check; the two run one after the other, as both load the same
# solution. smkproj.toml's Checks decides whether lint runs here, as it decides for `make ci`: a Unity project's
# C# has no project for analyzers, so its hook checks formatting alone.
lints=true

set -euo pipefail

# THE REPOSITORY'S OWN DEV SHELL, WHEREVER THE COMMIT COMES FROM. An smk found on PATH may be another
# checkout's, or one installed outside any dev shell, without the formatters this repository pins: a
# commit from an agent's or an IDE's shell then failed on a missing prettier rather than on its formatting.
# direnv builds the shell from .envrc, the same smk and formatters CI runs, and is quick when it is current.
top="$(git rev-parse --show-toplevel)"
if command -v direnv >/dev/null 2>&1 && [[ -f "$top/.envrc" ]]; then
  smk=(direnv exec "$top" smk)
elif command -v smk >/dev/null 2>&1; then
  smk=(smk)
else
  echo >&2 "pre-commit: neither direnv (with this repository's .envrc) nor smk is here to check the staged files; enter the dev shell (direnv allow) and commit again."
  exit 1
fi
"${smk[@]}" format --check --staged
if [[ "$lints" == true ]]; then
  exec "${smk[@]}" lint --staged
fi
