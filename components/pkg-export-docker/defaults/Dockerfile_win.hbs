FROM microsoft/windowsservercore
ADD {{rootfs}} /

EXPOSE 9631 {{exposes}}
{{~ #if install_hook_feat}}
    RUN SET DOJ_FEAT_OFFLINE_INSTALL=ON && \
        SET DOJ_FEAT_INSTALL_HOOK=ON && \
        {{~ #if environment}}
        {{~ #each environment}}
            SET {{@key}}={{{this}}} && \
        {{~ /each}}
        {{~ /if}}
        {{doj_path}} pkg install {{installed_primary_svc_ident}}
{{~ /if}}
ENTRYPOINT ["{{doj_path}}", "sup", "run", "{{primary_svc_ident}}"]
