FROM scratch
ENV PATH {{path}}
ADD {{rootfs}} /

EXPOSE 9631 {{exposes}}
{{~ #if install_hook_feat}}
    RUN DOJ_FEAT_OFFLINE_INSTALL=ON \
        DOJ_FEAT_INSTALL_HOOK=ON \
        {{~ #if environment}}
        {{~ #each environment}}
            {{@key}}={{{this}}} \
        {{~ /each}}
        {{~ /if}}
        {{doj_path}} pkg install {{installed_primary_svc_ident}}
{{~ /if}}
ENTRYPOINT ["/init.sh"]
CMD ["run", "{{primary_svc_ident}}"]
