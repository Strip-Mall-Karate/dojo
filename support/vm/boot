#!/usr/bin/env bash
# Boots the Dojo VM on an Apple silicon Mac with the serial console on this
# terminal (Ctrl-A X quits). --check boots, waits for the init to report and
# exits 0 only if it did and the VM then powered off cleanly; --check-reboot
# ends with a reboot instead. --payload adds a gzipped cpio archive
# (doj-launch, doj-sup and their libraries) on top of the initramfs.
#
# The VM always has eth0 on QEMU's user-mode network. --ring and --link add
# eth1 on a UDP tunnel between two QEMU processes on this Mac, which is how
# support/vm/ring joins two VMs; --peer and --members tell the Supervisor and
# the check about the other machine. --console serves the serial console on a
# local TCP port instead of this terminal, so two VMs can run at once.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: support/vm/boot [--check | --check-reboot] [--payload <file.cpio.gz>]
                       [--ring <addr/prefix> --link <local udp port>:<remote udp port>]
                       [--peer <addr>] [--members <n>] [--console <tcp port>]
EOF
  exit 2
}

check=false
check_args="dojo.check"
ending="reboot: Power down"
payload=""
ring=""
link=""
peer=""
members=""
console=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) check=true; shift ;;
    --check-reboot)
      check=true
      check_args="dojo.check dojo.reboot"
      ending="reboot: Restarting system"
      shift
      ;;
    --payload)
      [[ $# -ge 2 ]] || usage
      payload="$2"; shift 2 ;;
    --ring)
      [[ $# -ge 2 ]] || usage
      ring="$2"; shift 2 ;;
    --link)
      [[ $# -ge 2 ]] || usage
      link="$2"; shift 2 ;;
    --peer)
      [[ $# -ge 2 ]] || usage
      peer="$2"; shift 2 ;;
    --members)
      [[ $# -ge 2 ]] || usage
      members="$2"; shift 2 ;;
    --console)
      [[ $# -ge 2 ]] || usage
      console="$2"; shift 2 ;;
    *) usage ;;
  esac
done
if [[ -n "${payload}" && ! -f "${payload}" ]]; then
  echo "boot: no payload at ${payload}" >&2
  exit 2
fi
if [[ -n "${ring}" || -n "${link}" ]]; then
  if [[ ! "${ring}" =~ ^[0-9.]+/[0-9]+$ || ! "${link}" =~ ^[0-9]+:[0-9]+$ ]]; then
    echo "boot: --ring <addr/prefix> and --link <local udp port>:<remote udp port> go together" >&2
    exit 2
  fi
fi
if [[ -n "${members}" && ! "${members}" =~ ^[0-9]+$ ]]; then
  echo "boot: --members takes a count" >&2
  exit 2
fi
if [[ -n "${console}" ]] && "${check}"; then
  echo "boot: --check keeps the console itself" >&2
  exit 2
fi

if [[ "$(uname -sm)" != "Darwin arm64" ]]; then
  echo "boot: needs an Apple silicon Mac (Apple's hypervisor runs arm64 guests natively)" >&2
  exit 1
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# One evaluation for everything the VM needs: nix-build prints the paths in
# the order of the attributes, and an evaluation costs seconds on a busy Mac.
{
  read -r qemu
  read -r kernel
  read -r initrd
  read -r coreutils
} < <(nix-build --no-out-link "${here}" -A qemu -A kernel -A initrd -A coreutils)
qemu="${qemu}/bin/qemu-system-aarch64"
kernel="${kernel}/Image"
work="$(mktemp -d "${TMPDIR:-/tmp}/dojo-vm.XXXXXX")"
trap 'rm -rf "${work}"' EXIT
if [[ -n "${payload}" ]]; then
  # The kernel unpacks concatenated archives in order, so the payload lands
  # on top of the base initramfs.
  cat "${initrd}" "${payload}" > "${work}/initrd"
  initrd="${work}/initrd"
fi

append="console=ttyAMA0 panic=-1"
args=(
  -machine virt -accel hvf -cpu host -smp 4 -m 2048
  -kernel "${kernel}" -initrd "${initrd}"
  -no-reboot
  # eth0: QEMU's user-mode network needs no privilege, leases an address from
  # its own DHCP server and routes out through the Mac.
  -netdev user,id=net0 -device virtio-net-pci,netdev=net0
)
if [[ -n "${ring}" ]]; then
  # eth1: Ethernet frames in UDP datagrams between two QEMU processes on the
  # loopback, a link the user-mode network cannot offer. The guest addresses
  # it statically; init reads dojo.ring from the command line.
  args+=(
    -netdev "dgram,id=ring0,local.type=inet,local.host=127.0.0.1,local.port=${link%%:*},remote.type=inet,remote.host=127.0.0.1,remote.port=${link##*:}"
    -device virtio-net-pci,netdev=ring0
  )
  append+=" dojo.ring=${ring}"
fi
if [[ -n "${peer}" ]]; then
  append+=" dojo.peer=${peer}"
fi
if [[ -n "${members}" ]]; then
  check_args+=" dojo.members=${members}"
fi

if ! "${check}"; then
  if [[ -n "${console}" ]]; then
    echo "boot: serial console on 127.0.0.1:${console} (nc 127.0.0.1 ${console})" >&2
    "${qemu}" "${args[@]}" -append "${append}" \
      -display none -monitor none -serial "tcp:127.0.0.1:${console},server=on,wait=off"
  else
    "${qemu}" "${args[@]}" -append "${append}" -nographic
  fi
  exit
fi

log="${work}/check.log"
status=0
"${coreutils}/bin/timeout" 120 "${qemu}" "${args[@]}" -nographic -append "${append} quiet ${check_args}" </dev/null >"${log}" 2>&1 || status=$?
cat "${log}"
if [[ "${status}" -ne 0 ]]; then
  echo "boot: QEMU exited ${status} (124 is the 120 second deadline)" >&2
  exit 1
fi
if ! grep -q 'dojo: check ok' "${log}"; then
  echo "boot: the VM shut down without reporting success" >&2
  exit 1
fi
# The Supervisor says so when it has no route out and falls back to 127.0.0.1.
if grep -q 'IP Address lookup failed' "${log}"; then
  echo "boot: the Supervisor did not find its own address" >&2
  exit 1
fi
if grep -q 'Kernel panic' "${log}" || ! grep -q "${ending}" "${log}"; then
  echo "boot: the VM did not end cleanly (expected \"${ending}\")" >&2
  exit 1
fi
