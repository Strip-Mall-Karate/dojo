#!/bin/sh
# Stage 0 init: mounts the kernel filesystems, brings the network up and execs
# doj-launch, which runs as PID 1 and starts doj-sup. An image without
# doj-launch hands the console to a shell instead.

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
ip link set lo up
hostname dojo

echo "dojo: booted $(uname -srm)"

# The kernel command line says where this machine stands in a ring:
# dojo.ring=<addr/prefix> is its address on the link to the other machines,
# dojo.peer=<addr> the Supervisor it joins through.
ring=""
peer=""
# The kernel command line is words separated by spaces.
# shellcheck disable=SC2013
for word in $(cat /proc/cmdline); do
  case "${word}" in
  dojo.ring=*) ring="${word#dojo.ring=}" ;;
  dojo.peer=*) peer="${word#dojo.peer=}" ;;
  esac
done

# eth0 is QEMU's user-mode network. Its DHCP lease brings a default route,
# which the Supervisor needs to find its own address. udhcpc -n gives up after
# its retries rather than wait forever, so a VM without a NIC still boots.
ip link set eth0 up
udhcpc -i eth0 -s /bin/lease -n -q || echo "dojo: no DHCP lease on eth0"

# eth1 is the ring link: a static address on the second NIC boot attaches.
if [ -n "${ring}" ]; then
  ip addr add "${ring}" dev eth1
  ip link set eth1 up
fi

# dojo.install runs doj-install with the arguments in /etc/doj-install.args, a live
# image's answer file, and powers off without starting the Launcher.
if grep -qw dojo.install /proc/cmdline; then
  # The answer file holds words, one argument each.
  # shellcheck disable=SC2046
  if /bin/doj-install $(cat /etc/doj-install.args); then
    echo "dojo: install ok"
  else
    echo "dojo: install failed"
  fi
  sync
  poweroff -f
fi

if grep -qw dojo.check /proc/cmdline; then
  /bin/check &
fi

if [ -x /bin/doj-launch ]; then
  export DOJ_SUP_BINARY=/bin/doj-sup
  set -- run
  if [ -n "${peer}" ]; then
    set -- "$@" --peer "${peer}"
  fi
  exec /bin/doj-launch "$@"
fi

exec sh
